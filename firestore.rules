rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server Actions write through the Admin SDK, which bypasses these rules
    // entirely — they only matter if client code ever reads Firestore
    // directly. request.auth is populated by Firebase Auth, not by the
    // Auth.js/NextAuth session; wiring that up would need a Firebase custom
    // token minted from the NextAuth session on sign-in.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
