# Copy this file to .env.local and fill in the values.
# Full walkthrough for every free-tier signup: see SETUP.md.
# Nothing here is required to run `bun dev` — the app runs in "Modo demo"
# (mock data, no login) until you fill these in.

# ---- Auth.js (required once you want real login) ----------------------
# Generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Free. https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Firebase — Spark (free) plan --------------------------------------
# console.firebase.google.com → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# console.firebase.google.com → Project settings → Service accounts →
# Generate new private key. Keep FIREBASE_ADMIN_PRIVATE_KEY quoted with \n
# escapes exactly as downloaded.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- AI — optional ------------------------------------------------------
# platform.openai.com/api-keys. Requires billing set up on the OpenAI
# account (no free tier) — the AI feature stays inactive without it.
OPENAI_API_KEY=

# ---- Email reminders — optional, free tier ------------------------------
# resend.com → API Keys. 100 emails/day free, no card required.
RESEND_API_KEY=
# onboarding@resend.dev works without a verified domain. Verify your own
# domain in Resend later to send from it instead.
RESEND_FROM_EMAIL=Finanzas <onboarding@resend.dev>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Authorizes Vercel Cron (or your own curl) to call /api/cron/reminders.
CRON_SECRET=

# ---- Access control ------------------------------------------------------
# Comma-separated emails allowed to sign in. Leave empty during setup to
# allow anyone with a Google account (fine for local dev only).
AUTHORIZED_EMAILS=

# ---- Observability — all optional, all free tier -----------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Upstash Redis — optional, free tier --------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
